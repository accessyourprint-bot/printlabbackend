<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>PrintLab Admin</title><style>*{margin:0;padding:0;box-sizing:border-box;}body{font-family:"Segoe UI",system-ui,sans-serif;background:#f0f2f5;color:#1e293b;display:flex;min-height:100vh;}.sidebar{width:155px;background:#1e3a5f;min-height:100vh;position:fixed;top:0;left:0;display:flex;flex-direction:column;z-index:100;}.sid-logo{padding:14px 16px;border-bottom:1px solid rgba(255,255,255,.1);display:flex;align-items:center;gap:8px;}.sid-logo .logo-icon{width:28px;height:28px;background:#3b82f6;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:800;color:#fff;flex-shrink:0;}.sid-logo span{font-size:.82rem;font-weight:700;color:#fff;}.sid-nav{flex:1;padding:6px 0;}.sid-item{display:flex;align-items:center;gap:9px;padding:10px 16px;color:#94a3b8;cursor:pointer;font-size:.8rem;font-weight:500;border-left:3px solid transparent;transition:all .15s;white-space:nowrap;}.sid-item:hover{background:rgba(255,255,255,.06);color:#fff;}.sid-item.active{background:rgba(59,130,246,.15);color:#fff;border-left-color:#3b82f6;}.sid-item .ico{font-size:.9rem;width:16px;text-align:center;flex-shrink:0;}.main{margin-left:155px;flex:1;display:flex;flex-direction:column;min-width:0;}.topbar{background:#fff;border-bottom:1px solid #e2e8f0;padding:0 24px;height:48px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:50;}.topbar-title{font-size:.8rem;color:#64748b;font-weight:500;}.topbar-right{display:flex;align-items:center;gap:10px;}.avatar{width:30px;height:30px;background:#3b82f6;border-radius:50%;color:#fff;font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;}.logout-btn{background:none;border:1px solid #e2e8f0;color:#64748b;padding:4px 10px;border-radius:5px;cursor:pointer;font-size:.75rem;}.content{padding:24px;flex:1;}.page-hd{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;}.page-hd h1{font-size:1.3rem;font-weight:700;color:#1e293b;}.page-hd p{font-size:.78rem;color:#64748b;margin-top:2px;}.add-btn{background:#1e3a5f;color:#fff;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:.78rem;font-weight:600;display:flex;align-items:center;gap:5px;white-space:nowrap;}.add-btn:hover{background:#2d4f7c;}.stats-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin-bottom:24px;}.stat-card{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:16px 18px;display:flex;justify-content:space-between;align-items:flex-start;}.stat-card .val{font-size:1.5rem;font-weight:800;color:#1e293b;line-height:1;}.stat-card .lbl{font-size:.7rem;color:#64748b;margin-top:4px;font-weight:500;}.stat-card .sub{font-size:.68rem;color:#10b981;margin-top:2px;}.stat-card .icon-box{width:36px;height:36px;border-radius:8px;background:#eff6ff;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0;}.panel{background:#fff;border:1px solid #e2e8f0;border-radius:10px;overflow:hidden;margin-bottom:18px;}.panel-hd{display:flex;justify-content:space-between;align-items:center;padding:13px 18px;border-bottom:1px solid #f1f5f9;}.panel-hd h3{font-size:.85rem;font-weight:700;color:#1e293b;}.main-grid{display:grid;grid-template-columns:1fr 300px;gap:18px;}table{width:100%;border-collapse:collapse;}th{background:#f8fafc;color:#64748b;font-size:.7rem;font-weight:700;padding:10px 16px;text-align:left;text-transform:uppercase;letter-spacing:.4px;border-bottom:1px solid #e2e8f0;}td{padding:11px 16px;border-bottom:1px solid #f1f5f9;font-size:.82rem;color:#1e293b;}tr:last-child td{border-bottom:none;}tr:hover td{background:#fafbfc;}.badge{display:inline-flex;align-items:center;padding:2px 8px;border-radius:20px;font-size:.7rem;font-weight:600;}.b-green{background:#d1fae5;color:#065f46;}.b-blue{background:#1e3a5f;color:#fff;}.b-lblue{background:#dbeafe;color:#1e40af;}.b-yellow{background:#fef3c7;color:#92400e;}.b-red{background:#fee2e2;color:#991b1b;}.b-gray{background:#f1f5f9;color:#64748b;}.b-orange{background:#ffedd5;color:#9a3412;}.b-teal{background:#ccfbf1;color:#134e4a;}.btn{padding:6px 12px;border:none;border-radius:6px;cursor:pointer;font-size:.76rem;font-weight:600;transition:opacity .15s;}.btn:hover{opacity:.85;}.btn-sm{padding:4px 9px;font-size:.72rem;}.btn-primary{background:#1e3a5f;color:#fff;}.btn-red{background:#ef4444;color:#fff;}.btn-ghost{background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0;}.toggle{position:relative;width:38px;height:20px;flex-shrink:0;}.toggle input{opacity:0;width:0;height:0;}.tog-sl{position:absolute;cursor:pointer;inset:0;background:#cbd5e1;border-radius:20px;transition:.2s;}.tog-sl:before{content:"";position:absolute;width:14px;height:14px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.2s;}input:checked+.tog-sl{background:#1e3a5f;}input:checked+.tog-sl:before{transform:translateX(18px);}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;}.fg label{display:block;font-size:.74rem;font-weight:600;color:#64748b;margin-bottom:4px;}.fg input,.fg select{width:100%;padding:8px 10px;border:1px solid #e2e8f0;border-radius:6px;font-size:.84rem;color:#1e293b;background:#fafafa;}.fg input:focus,.fg select:focus{outline:none;border-color:#3b82f6;}.hidden{display:none!important;}.pg{display:none;}.empty{text-align:center;padding:32px;color:#94a3b8;font-size:.84rem;}.loading{text-align:center;padding:24px;color:#3b82f6;font-size:.82rem;}.chart-wrap{padding:16px 20px 0;}.chart-bars{display:flex;align-items:flex-end;height:200px;border-left:1px solid #e2e8f0;border-bottom:1px solid #e2e8f0;padding:0 20px 0 8px;}.chart-bar-group{display:flex;flex-direction:column;align-items:center;flex:1;gap:4px;}.chart-bar{width:60%;border-radius:4px 4px 0 0;min-height:4px;}.chart-bar-val{font-size:.72rem;font-weight:700;color:#1e293b;}.chart-bar-lbl{font-size:.7rem;color:#64748b;margin-top:4px;padding-bottom:6px;}.drop-sel{padding:5px 8px;border:1px solid #e2e8f0;border-radius:6px;font-size:.76rem;color:#64748b;background:#fff;cursor:pointer;}.price-input{width:80px;padding:4px 8px;border:1px solid #e2e8f0;border-radius:5px;font-size:.82rem;text-align:right;}.icon-btn{background:none;border:none;cursor:pointer;font-size:1rem;padding:2px;}.login-wrap{display:flex;align-items:center;justify-content:center;height:100vh;background:#1e3a5f;position:fixed;inset:0;z-index:999;}.login-box{background:#fff;border-radius:14px;padding:36px;width:320px;}.login-box h2{font-size:1.2rem;font-weight:800;color:#1e3a5f;margin-bottom:3px;}.login-box p{font-size:.78rem;color:#64748b;margin-bottom:22px;}.lf label{display:block;font-size:.74rem;font-weight:600;color:#64748b;margin-bottom:4px;}.lf input{width:100%;padding:10px 11px;border:1.5px solid #e2e8f0;border-radius:7px;font-size:.9rem;margin-bottom:12px;color:#1e293b;}.lf input:focus{outline:none;border-color:#1e3a5f;}.login-btn{width:100%;padding:11px;background:#1e3a5f;color:#fff;border:none;border-radius:7px;font-size:.9rem;font-weight:700;cursor:pointer;}.lerr{color:#ef4444;font-size:.76rem;margin-top:8px;text-align:center;}@media(max-width:1100px){.stats-grid{grid-template-columns:repeat(3,1fr);}.main-grid{grid-template-columns:1fr;}}</style></head><body>
<div id="loginWrap" class="login-wrap"><div class="login-box"><h2>PrintLab Admin</h2><p>Command Center — Owner Access</p><div class="lf"><label>Email</label><input type="email" id="lEm" value="admin@altprint.in"><label>Password</label><input type="password" id="lPw" value="AltPrint2024!"><button class="login-btn" onclick="doLogin()">Sign In</button><div class="lerr" id="lErr"></div></div></div></div>
<div id="appWrap" class="hidden" style="display:flex;min-height:100vh;width:100%;"><div class="sidebar"><div class="sid-logo"><div class="logo-icon">PL</div><span>PrintLab Admin</span></div><nav class="sid-nav"><div class="sid-item active" onclick="nav(this,'dashboard')"><span class="ico">📊</span><span>Dashboard</span></div><div class="sid-item" onclick="nav(this,'outlets')"><span class="ico">🏪</span><span>Outlets</span></div><div class="sid-item" onclick="nav(this,'orders')"><span class="ico">🛒</span><span>Orders</span></div><div class="sid-item" onclick="nav(this,'delivery')"><span class="ico">🚴</span><span>Delivery</span></div><div class="sid-item" onclick="nav(this,'pricing')"><span class="ico">💲</span><span>Pricing</span></div><div class="sid-item" onclick="nav(this,'stock')"><span class="ico">📦</span><span>Stock</span></div><div class="sid-item" onclick="nav(this,'accounts')"><span class="ico">💰</span><span>Accounts</span></div><div class="sid-item" onclick="nav(this,'tickets')"><span class="ico">🎫</span><span>Tickets</span></div></nav></div><div class="main"><div class="topbar"><span class="topbar-title">Command Center</span><div class="topbar-right"><div class="avatar">AD</div><button class="logout-btn" onclick="doLogout()">Logout</button></div></div><div class="content">
<div id="pg-dashboard" class="pg" style="display:block"><div class="page-hd"><div><h1>Overview</h1><p>Live metrics across the entire franchise network.</p></div></div><div class="stats-grid"><div class="stat-card"><div><div class="val" id="ds-outlets">—</div><div class="lbl">Total Outlets</div><div class="sub" id="ds-outlets-sub"></div></div><div class="icon-box">🏪</div></div><div class="stat-card"><div><div class="val" id="ds-orders">—</div><div class="lbl">Total Orders</div></div><div class="icon-box">🛒</div></div><div class="stat-card"><div><div class="val" id="ds-pending">—</div><div class="lbl">Pending Orders</div></div><div class="icon-box" style="background:#fff7ed">⏱</div></div><div class="stat-card"><div><div class="val" id="ds-revenue">—</div><div class="lbl">Revenue</div></div><div class="icon-box" style="background:#f0fdf4">💲</div></div><div class="stat-card"><div><div class="val" id="ds-tickets">—</div><div class="lbl">Open Tickets</div></div><div class="icon-box" style="background:#fefce8">🎫</div></div></div><div class="main-grid"><div><div class="panel"><div class="panel-hd"><h3>Orders by Print Type</h3></div><div class="chart-wrap"><div class="chart-bars" id="barChart"></div></div><div style="height:12px"></div></div><div class="panel"><div class="panel-hd"><h3>Recent Orders</h3></div><div id="recentOrders"><div class="loading">Loading…</div></div></div></div><div class="panel"><div class="panel-hd"><h3>Outlet Performance</h3></div><div id="outletPerf"><div class="loading">Loading…</div></div></div></div></div>
<div id="pg-outlets" class="pg"><div class="page-hd"><div><h1>Outlets</h1><p>Manage franchise locations.</p></div><button class="add-btn" onclick="showAddOutlet()">+ Add Outlet</button></div><div class="panel"><div id="outletsTbl"><div class="loading">Loading…</div></div></div><div id="addOutletForm" class="panel hidden" style="padding:18px"><h3 style="margin-bottom:14px;font-size:.9rem">New Outlet</h3><div class="form-row"><div class="fg"><label>Outlet Name</label><input id="ot-nm" placeholder="Keerthi Print Center"></div><div class="fg"><label>Phone</label><input id="ot-ph" placeholder="9876543210"></div><div class="fg"><label>Address</label><input id="ot-ad" placeholder="Street, City"></div><div class="fg"><label>Email</label><input id="ot-em" placeholder="outlet@altprint.in"></div></div><button class="btn btn-primary" onclick="addOutlet()">Create Outlet</button><button class="btn btn-ghost" style="margin-left:8px" onclick="document.getElementById('addOutletForm').classList.add('hidden')">Cancel</button></div></div>
<div id="pg-orders" class="pg"><div class="page-hd"><div><h1>Orders</h1><p>Manage print jobs from all outlets.</p></div><div style="display:flex;gap:8px"><select class="drop-sel" id="typeFilter" onchange="filterOrders()"><option value="">All Types</option><option>B/W</option><option>Colour</option><option>Photo</option><option>T-shirt</option><option>Project</option></select><select class="drop-sel" id="statusFilter" onchange="filterOrders()"><option value="">All Status</option><option>pending</option><option>confirmed</option><option>printing</option><option>approved</option><option>delivered</option><option>cancelled</option></select></div></div><div class="panel"><div id="ordersTbl"><div class="loading">Loading…</div></div></div></div>
<div id="pg-delivery" class="pg"><div class="page-hd"><div><h1>Delivery Fleet</h1><p>Manage delivery personnel.</p></div><button class="add-btn" onclick="showAddAgent()">+ Add Driver</button></div><div class="panel"><div id="agentsTbl"><div class="loading">Loading…</div></div></div><div id="addAgentForm" class="panel hidden" style="padding:18px"><h3 style="margin-bottom:14px;font-size:.9rem">New Delivery Agent</h3><div class="form-row"><div class="fg"><label>Name</label><input id="ag-nm" placeholder="Full name"></div><div class="fg"><label>Phone</label><input id="ag-ph" placeholder="9876543210"></div><div class="fg"><label>Vehicle</label><input id="ag-veh" placeholder="Honda Activa - TN01AB1234"></div><div class="fg"><label>Shop ID</label><input id="ag-sh" value="shop-001"></div></div><button class="btn btn-primary" onclick="addAgent()">Add Agent</button><button class="btn btn-ghost" style="margin-left:8px" onclick="document.getElementById('addAgentForm').classList.add('hidden')">Cancel</button></div></div>
<div id="pg-pricing" class="pg"><div class="page-hd"><div><h1>Pricing</h1><p>Configure print rates across all outlets.</p></div><button class="add-btn">+ Add Rule</button></div><div class="panel"><table><tr><th>Type</th><th>Description</th><th>Price/Page</th><th>Actions</th></tr><tr><td><b>B/W</b></td><td style="color:#64748b">Black and white print</td><td>Rs <input class="price-input" type="number" value="1.5"></td><td><button class="icon-btn">🗑</button></td></tr><tr><td><b>Colour</b></td><td style="color:#64748b">Full color print</td><td>Rs <input class="price-input" type="number" value="5"></td><td><button class="icon-btn">🗑</button></td></tr><tr><td><b>Photo</b></td><td style="color:#64748b">Glossy photo print</td><td>Rs <input class="price-input" type="number" value="25"></td><td><button class="icon-btn">🗑</button></td></tr><tr><td><b>T-shirt</b></td><td style="color:#64748b">T-shirt custom print</td><td>Rs <input class="price-input" type="number" value="250"></td><td><button class="icon-btn">🗑</button></td></tr><tr><td><b>Project</b></td><td style="color:#64748b">Project report binding</td><td>Rs <input class="price-input" type="number" value="3"></td><td><button class="icon-btn">🗑</button></td></tr></table></div></div>
<div id="pg-stock" class="pg"><div class="page-hd"><div><h1>Stock Inventory</h1><p>Track central warehouse supplies.</p></div><button class="add-btn" onclick="showAddStock()">+ Add Item</button></div><div class="panel"><div id="stockTbl"><div class="loading">Loading…</div></div></div><div id="addStockForm" class="panel hidden" style="padding:18px"><h3 style="margin-bottom:14px;font-size:.9rem">Add Stock Item</h3><div class="form-row"><div class="fg"><label>Item Name</label><input id="sk-nm" placeholder="A4 Paper Ream"></div><div class="fg"><label>Category</label><input id="sk-cat" placeholder="Paper / Ink / Toner"></div><div class="fg"><label>Quantity</label><input id="sk-qty" type="number" placeholder="500"></div><div class="fg"><label>Unit</label><input id="sk-unit" placeholder="reams / sheets"></div><div class="fg"><label>Min Level</label><input id="sk-min" type="number" placeholder="50"></div></div><button class="btn btn-primary" onclick="addStock()">Add Item</button><button class="btn btn-ghost" style="margin-left:8px" onclick="document.getElementById('addStockForm').classList.add('hidden')">Cancel</button></div></div>
<div id="pg-accounts" class="pg"><div class="page-hd"><div><h1>Accounts</h1><p>Franchise transactions and payments.</p></div><button class="add-btn">+ Add Record</button></div><div class="panel"><div id="accountsTbl"><div class="loading">Loading…</div></div></div></div>
<div id="pg-tickets" class="pg"><div class="page-hd"><div><h1>Support Tickets</h1><p>Manage issues from franchise operators.</p></div></div><div class="panel"><div id="ticketsTbl"><div class="loading">Loading…</div></div></div></div>
</div></div></div>
<script>
const API=window.location.origin;
let TOK=null;
let allOrders=[];
const DEMO={
outlets:[{id:'s1',name:'Keerthi Print Center',phone:'9876543210',is_active:true},{id:'s2',name:'Raj Copy World',phone:'9876541234',is_active:true},{id:'s3',name:'Sri Print Hub',phone:'9123456789',is_active:true},{id:'s4',name:'Quick Print Express',phone:'8012345678',is_active:false}],
orders:[{id:'o1',order_number:'ORD0001',shop_name:'Keerthi Print Center',user_name:'Keerthi R',user_phone:'1234567890',print_type:'B/W',status:'delivered',grand_total:45,delivery_agent:'Ravi Kumar'},{id:'o2',order_number:'ORD0002',shop_name:'Raj Copy World',user_name:'Arjun M',user_phone:'9876543211',print_type:'Colour',status:'printing',grand_total:150,delivery_agent:'Unassigned'},{id:'o3',order_number:'ORD0003',shop_name:'Keerthi Print Center',user_name:'Priya S',user_phone:'8765432109',print_type:'Photo',status:'approved',grand_total:250,delivery_agent:'Murugan S'},{id:'o4',order_number:'ORD0004',shop_name:'Sri Print Hub',user_name:'Vijay K',user_phone:'7654321098',print_type:'Project',status:'pending',grand_total:120,delivery_agent:'Unassigned'},{id:'o5',order_number:'ORD0005',shop_name:'Raj Copy World',user_name:'Anitha B',user_phone:'6543210987',print_type:'T-shirt',status:'pending',grand_total:750,delivery_agent:'Unassigned'},{id:'o6',order_number:'ORD0006',shop_name:'Quick Print Express',user_name:'Suresh P',user_phone:'5432109876',print_type:'B/W',status:'delivered',grand_total:30,delivery_agent:'Dinesh P'},{id:'o7',order_number:'ORD0007',shop_name:'Keerthi Print Center',user_name:'Lakshmi N',user_phone:'9871234560',print_type:'Colour',status:'approved',grand_total:200,delivery_agent:'Ravi Kumar'}],
agents:[{id:'a1',name:'Ravi Kumar',phone:'9988776655',vehicle_number:'Honda Activa - TN01AB1234',current_status:'available'},{id:'a2',name:'Murugan S',phone:'9977665544',vehicle_number:'TVS Jupiter - TN02CD5678',current_status:'available'},{id:'a3',name:'Dinesh P',phone:'9966554433',vehicle_number:'Hero Splendor - TN03EF9012',current_status:'available'}],
stock:[{id:'sk1',item_name:'A3 Paper Ream',category:'Paper',quantity:12,unit:'reams'},{id:'sk2',item_name:'A4 Paper Ream',category:'Paper',quantity:45,unit:'reams'},{id:'sk3',item_name:'Binding Rings (100pk)',category:'Binding',quantity:15,unit:'packs'},{id:'sk4',item_name:'Black Ink Cartridge',category:'Ink',quantity:8,unit:'units'},{id:'sk5',item_name:'Color Ink Set',category:'Ink',quantity:5,unit:'sets'},{id:'sk6',item_name:'Glossy Photo Paper',category:'Paper',quantity:200,unit:'sheets'},{id:'sk7',item_name:'Lamination Sheets',category:'Lamination',quantity:100,unit:'sheets'},{id:'sk8',item_name:'Toner Cartridge HP',category:'Toner',quantity:3,unit:'units'}],
accounts:[{date:'13/06/2026',outlet:'Keerthi Print Center',desc:'Monthly settlement - May',type:'CREDIT',status:'paid',amount:5000},{date:'13/06/2026',outlet:'Raj Copy World',desc:'Monthly settlement - May',type:'CREDIT',status:'paid',amount:3500},{date:'13/06/2026',outlet:'Sri Print Hub',desc:'Paper stock advance',type:'DEBIT',status:'pending',amount:-500},{date:'13/06/2026',outlet:'Keerthi Print Center',desc:'Weekly payment - Week 1 Jun',type:'CREDIT',status:'pending',amount:2000},{date:'13/06/2026',outlet:'Quick Print Express',desc:'Equipment deposit',type:'DEBIT',status:'overdue',amount:-1500}],
tickets:[{id:'t1',num:1,date:'13/06/2026',outlet:'Keerthi Print Center',subject:'Printer not working',desc:'Main printer paper jam issue...',priority:'high',status:'open'},{id:'t2',num:2,date:'13/06/2026',outlet:'Raj Copy World',subject:'Low stock alert',desc:'Running out of A4 paper...',priority:'medium',status:'in-progress'},{id:'t3',num:3,date:'13/06/2026',outlet:'Sri Print Hub',subject:'Payment not received',desc:'Last month settlement pending',priority:'high',status:'open'},{id:'t4',num:4,date:'13/06/2026',outlet:'Quick Print Express',subject:'Need new ink cartridges',desc:'Color ink almost finished',priority:'low',status:'closed'}]
};
async function doLogin(){
  const email=document.getElementById('lEm').value;
  const pass=document.getElementById('lPw').value;
  document.getElementById('lErr').textContent='';
  try{
    const r=await fetch(API+'/api/v1/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,password:pass})});
    const d=await r.json();
    if(d.access_token){TOK=d.access_token;}else{TOK='demo';}
  }catch(e){TOK='demo';}
  bootApp();
}
function bootApp(){document.getElementById('loginWrap').classList.add('hidden');const a=document.getElementById('appWrap');a.classList.remove('hidden');a.style.display='flex';loadDash();}
function doLogout(){TOK=null;location.reload();}
function nav(el,id){document.querySelectorAll('.sid-item').forEach(s=>s.classList.remove('active'));el.classList.add('active');document.querySelectorAll('.pg').forEach(p=>p.style.display='none');document.getElementById('pg-'+id).style.display='block';const L={dashboard:loadDash,outlets:loadOutlets,orders:loadOrders,delivery:loadAgents,stock:loadStock,accounts:loadAccounts,tickets:loadTickets};if(L[id])L[id]();}
async function apiGet(u){try{const h={};if(TOK&&TOK!=='demo')h['Authorization']='Bearer '+TOK;const r=await fetch(API+u,{headers:h});if(!r.ok)return null;return r.json();}catch(e){return null;}}
async function apiPost(u,m,b){try{const o={method:m,headers:{}};if(TOK&&TOK!=='demo')o.headers['Authorization']='Bearer '+TOK;if(b){o.headers['Content-Type']='application/json';o.body=JSON.stringify(b);}const r=await fetch(API+u,o);return r.json();}catch(e){return null;}}
function stCls(s){const m={delivered:'b-green',completed:'b-green',printing:'b-lblue',approved:'b-lblue',pending:'b-yellow',confirmed:'b-lblue',cancelled:'b-red',closed:'b-gray','in-progress':'b-teal',in_progress:'b-teal',open:'b-blue'};return m[s]||'b-gray';}
function prCls(p){return p==='high'?'b-red':p==='medium'?'b-yellow':'b-gray';}
function guessType(o){const s=JSON.stringify(o).toLowerCase();if(s.includes('colour')||s.includes('color'))return'Colour';if(s.includes('photo'))return'Photo';if(s.includes('tshirt')||s.includes('t-shirt'))return'T-shirt';if(s.includes('project'))return'Project';return'B/W';}
const COLORS=['#3b82f6','#f97316','#14b8a6','#d946ef','#eab308'];
const PTYPES=['Colour','B/W','Project','Photo','T-shirt'];
async function loadDash(){const[od,sd,td]=await Promise.all([apiGet('/api/v1/orders'),apiGet('/api/v1/shops'),apiGet('/api/v1/tickets')]);const orders=Array.isArray(od)?od:(od&&od.data?od.data:DEMO.orders);const outlets=Array.isArray(sd)?sd:(sd&&sd.data?sd.data:DEMO.outlets);const tickets=Array.isArray(td)?td:(td&&td.data?td.data:DEMO.tickets);const rev=orders.filter(o=>['completed','delivered'].includes(o.status)).reduce((s,o)=>s+(o.grand_total||0),0);document.getElementById('ds-outlets').textContent=outlets.length;document.getElementById('ds-outlets-sub').textContent=outlets.filter(s=>s.is_active).length+' active';document.getElementById('ds-orders').textContent=orders.length;document.getElementById('ds-pending').textContent=orders.filter(o=>o.status==='pending').length;document.getElementById('ds-revenue').textContent='Rs'+rev.toLocaleString();document.getElementById('ds-tickets').textContent=tickets.filter(t=>t.status==='open').length;const counts={};PTYPES.forEach(t=>counts[t]=0);orders.forEach(o=>{const pt=o.print_type||guessType(o);if(counts[pt]!==undefined)counts[pt]++;else counts['B/W']++;});const maxV=Math.max(...Object.values(counts),1);document.getElementById('barChart').innerHTML=PTYPES.map((t,i)=>'<div class="chart-bar-group"><div class="chart-bar-val">'+counts[t]+'</div><div class="chart-bar" style="height:'+Math.max(counts[t]/maxV*160,4)+'px;background:'+COLORS[i]+'"></div><div class="chart-bar-lbl">'+t+'</div></div>').join('');document.getElementById('recentOrders').innerHTML='<table><tr><th>ID</th><th>Outlet</th><th>Customer</th><th>Type</th><th>Status</th><th>Amount</th></tr>'+orders.slice(0,7).map(o=>'<tr><td style="color:#3b82f6;font-size:.75rem">'+(o.order_number||o.id||'—')+'</td><td>'+(o.shop_name||'—')+'</td><td>'+(o.user_name||'Customer')+'</td><td>'+(o.print_type||guessType(o))+'</td><td><span class="badge '+stCls(o.status)+'">'+o.status+'</span></td><td>Rs'+(o.grand_total||0)+'</td></tr>').join('')+'</table>';document.getElementById('outletPerf').innerHTML='<table><tr><th>Outlet</th><th>Orders</th><th>Revenue</th></tr>'+outlets.map(s=>{const so=orders.filter(o=>o.shop_id===s.id||o.shop_name===s.name);const sr=so.filter(o=>['completed','delivered'].includes(o.status)).reduce((a,o)=>a+(o.grand_total||0),0);return'<tr><td><b>'+s.name+'</b></td><td>'+so.length+'</td><td>Rs'+sr+'</td></tr>';}).join('')+'</table>';}
async function loadOutlets(){const d=await apiGet('/api/v1/shops');const outlets=Array.isArray(d)?d:(d&&d.data?d.data:DEMO.outlets);document.getElementById('outletsTbl').innerHTML='<table><tr><th>Code</th><th>Name</th><th>Phone</th><th>Status</th><th>Actions</th></tr>'+outlets.map((s,i)=>'<tr><td style="color:#64748b;font-size:.74rem">OTL'+String(i+1).padStart(4,'0')+'</td><td><b>'+s.name+'</b></td><td>'+(s.phone||'—')+'</td><td><span class="badge '+(s.is_active?'b-blue':'b-gray')+'">'+(s.is_active?'Active':'Inactive')+'</span></td><td style="display:flex;align-items:center;gap:6px"><label class="toggle"><input type="checkbox" '+(s.is_active?'checked':'')+' onchange="toggleShop(\''+s.id+'\',this.checked)"><span class="tog-sl"></span></label><button class="icon-btn" onclick="if(confirm(\'Delete?\'))deleteShop(\''+s.id+'\')" style="color:#ef4444">🗑</button></td></tr>').join('')+'</table>';}
async function toggleShop(id,on){await apiPost('/api/v1/admin/users/'+id+'/status?is_active='+on,'PATCH');}
async function deleteShop(id){await apiPost('/api/v1/shops/'+id,'DELETE');loadOutlets();}
function showAddOutlet(){document.getElementById('addOutletForm').classList.remove('hidden');}
async function addOutlet(){const nm=document.getElementById('ot-nm').value;if(!nm){alert('Name required');return;}await apiPost('/api/v1/shops','POST',{name:nm,phone:document.getElementById('ot-ph').value,address:document.getElementById('ot-ad').value,email:document.getElementById('ot-em').value});document.getElementById('addOutletForm').classList.add('hidden');document.getElementById('ot-nm').value='';loadOutlets();}
async function loadOrders(){const d=await apiGet('/api/v1/orders');allOrders=Array.isArray(d)?d:(d&&d.data?d.data:DEMO.orders);renderOrders(allOrders);}
function filterOrders(){const t=document.getElementById('typeFilter').value,s=document.getElementById('statusFilter').value;renderOrders(allOrders.filter(o=>(!t||(o.print_type||guessType(o))===t)&&(!s||o.status===s)));}
function renderOrders(orders){document.getElementById('ordersTbl').innerHTML=orders.length?'<table><tr><th>Order ID</th><th>Outlet</th><th>Customer</th><th>Print Type</th><th>Status</th><th>Delivery</th><th>Amount</th></tr>'+orders.map(o=>'<tr><td style="color:#3b82f6;font-size:.75rem">'+(o.order_number||o.id||'—')+'</td><td>'+(o.shop_name||'—')+'</td><td><b>'+(o.user_name||'Customer')+'</b><br><span style="font-size:.72rem;color:#64748b">'+(o.user_phone||'')+'</span></td><td>'+(o.print_type||guessType(o))+'</td><td><span class="badge '+stCls(o.status)+'">'+o.status+'</span></td><td style="color:#64748b;font-size:.78rem">'+(o.delivery_agent||'Unassigned')+'</td><td>Rs'+(o.grand_total||0)+'</td></tr>').join('')+'</table>':'<div class="empty">No orders found</div>';}
async function loadAgents(){const d=await apiGet('/api/v1/delivery-persons');const agents=Array.isArray(d)?d:(d&&d.data?d.data:DEMO.agents);document.getElementById('agentsTbl').innerHTML=agents.length?'<table><tr><th>Name</th><th>Phone</th><th>Vehicle</th><th>Available</th><th>Actions</th></tr>'+agents.map(a=>'<tr><td><b>'+a.name+'</b></td><td>'+a.phone+'</td><td>'+(a.vehicle_number||'—')+'</td><td><label class="toggle"><input type="checkbox" '+(a.current_status==='available'?'checked':'')+' onchange="toggleAgent(\''+a.id+'\',this.checked)"><span class="tog-sl"></span></label></td><td><button class="btn btn-red btn-sm" onclick="if(confirm(\'Remove?\'))delAgent(\''+a.id+'\')">🗑</button></td></tr>').join('')+'</table>':'<div class="empty">No delivery agents.</div>';}
function showAddAgent(){document.getElementById('addAgentForm').classList.remove('hidden');}
async function addAgent(){const nm=document.getElementById('ag-nm').value,ph=document.getElementById('ag-ph').value;if(!nm||!ph){alert('Name and phone required');return;}await apiPost('/api/v1/delivery-persons?shop_id='+document.getElementById('ag-sh').value,'POST',{name:nm,phone:ph,vehicle_number:document.getElementById('ag-veh').value});document.getElementById('addAgentForm').classList.add('hidden');loadAgents();}
async function delAgent(id){await apiPost('/api/v1/delivery-persons/'+id,'DELETE');loadAgents();}
async function toggleAgent(id,on){await apiPost('/api/v1/delivery-persons/'+id+'/status?available='+on,'PATCH');}
async function loadStock(){const d=await apiGet('/api/v1/stock');const items=Array.isArray(d)?d:(d&&d.data?d.data:DEMO.stock);document.getElementById('stockTbl').innerHTML=items.length?'<table><tr><th>Item Name</th><th>Category</th><th>Status</th><th>Quantity</th></tr>'+items.map(i=>'<tr><td><b>'+(i.item_name||i.name)+'</b></td><td style="color:#64748b">'+(i.category||'—')+'</td><td><span class="badge b-green">Optimal</span></td><td><input class="price-input" style="width:80px" type="number" value="'+i.quantity+'"></td></tr>').join('')+'</table>':'<div class="empty">No stock items.</div>';}
function showAddStock(){document.getElementById('addStockForm').classList.remove('hidden');}
async function addStock(){const nm=document.getElementById('sk-nm').value,qty=+document.getElementById('sk-qty').value;if(!nm||!qty){alert('Name and quantity required');return;}await apiPost('/api/v1/stock','POST',{item_name:nm,category:document.getElementById('sk-cat').value,quantity:qty,unit:document.getElementById('sk-unit').value,min_quantity:+document.getElementById('sk-min').value||10});document.getElementById('addStockForm').classList.add('hidden');loadStock();}
async function loadAccounts(){const d=await apiGet('/api/v1/analytics/cashflow');const txns=(d&&d.transactions)?d.transactions:DEMO.accounts;document.getElementById('accountsTbl').innerHTML=txns.length?'<table><tr><th>Date</th><th>Outlet</th><th>Description</th><th>Type</th><th>Status</th><th>Amount</th></tr>'+txns.map(t=>'<tr><td style="color:#64748b">'+(t.date||new Date(t.created_at||Date.now()).toLocaleDateString())+'</td><td>'+(t.outlet||'—')+'</td><td>'+(t.desc||t.order_number||'Transaction')+'</td><td><span class="badge '+(t.type==='CREDIT'?'b-green':'b-orange')+'">'+(t.type||'CREDIT')+'</span></td><td style="color:#64748b">'+(t.status||'—')+'</td><td style="color:'+((t.amount||0)<0?'#ef4444':'#10b981')+';font-weight:700">'+((t.amount||0)>0?'+':'')+'Rs'+Math.abs(t.amount||0).toLocaleString()+'</td></tr>').join('')+'</table>':'<div class="empty">No transactions yet</div>';}
async function loadTickets(){const d=await apiGet('/api/v1/tickets');const tickets=Array.isArray(d)?d:(d&&d.data?d.data:DEMO.tickets);document.getElementById('ticketsTbl').innerHTML=tickets.length?'<table><tr><th>ID / Date</th><th>Outlet</th><th>Subject</th><th>Priority</th><th>Status</th><th>Action</th></tr>'+tickets.map((t,i)=>'<tr><td><b>#'+(t.num||i+1)+'</b><br><small style="color:#64748b">'+(t.date||new Date(t.created_at||Date.now()).toLocaleDateString())+'</small></td><td>'+(t.outlet||t.shop_id||'—')+'</td><td><b>'+(t.subject||'—')+'</b><br><small style="color:#94a3b8">'+(t.desc||t.description||t.message||'').slice(0,40)+'</small></td><td><span class="badge '+prCls(t.priority)+'">'+(t.priority||'low').toUpperCase()+'</span></td><td><span class="badge '+stCls(t.status)+'">'+t.status+'</span></td><td><button class="btn btn-ghost btn-sm" onclick="resolveT(\''+t.id+'\')">📩 Respond</button></td></tr>').join('')+'</table>':'<div class="empty">No tickets raised</div>';}
async function resolveT(id){await apiPost('/api/v1/tickets/'+id,'PATCH',{status:'resolved'});loadTickets();}
</script></body></html>