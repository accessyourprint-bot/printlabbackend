<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PrintLab — Outlet</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:"Segoe UI",system-ui,sans-serif;background:#f5f0eb;color:#1a1a1a;min-height:100vh;}
.login-wrap{display:flex;align-items:center;justify-content:center;min-height:100vh;background:#f5f0eb;}
.login-box{background:#fff;border-radius:14px;padding:40px;width:340px;box-shadow:0 4px 20px rgba(0,0,0,.08);}
.login-box h2{font-size:1.3rem;font-weight:800;margin-bottom:4px;}
.login-box p{color:#666;font-size:.84rem;margin-bottom:24px;}
.lf label{display:block;font-size:.8rem;font-weight:600;color:#444;margin-bottom:5px;}
.lf input{width:100%;padding:11px 12px;border:1.5px solid #e0e0e0;border-radius:8px;font-size:.93rem;margin-bottom:14px;}
.lf input:focus{outline:none;border-color:#e84c1e;}
.login-btn{width:100%;padding:12px;background:#e84c1e;color:#fff;border:none;border-radius:8px;font-size:.95rem;font-weight:700;cursor:pointer;}
.lerr{color:#e84c1e;font-size:.8rem;margin-top:8px;text-align:center;}
.select-wrap{min-height:100vh;background:#f5f0eb;padding:48px 24px;}
.select-center{max-width:860px;margin:0 auto;}
.printer-icon{width:72px;height:72px;background:#fde8e0;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:2rem;}
.select-center>h1{text-align:center;font-size:2rem;font-weight:900;color:#1a1a1a;margin-bottom:8px;}
.select-center>p{text-align:center;color:#888;font-size:.95rem;margin-bottom:36px;}
.outlets-hd{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
.outlets-hd h2{font-size:1.1rem;font-weight:800;}
.new-outlet-btn{display:flex;align-items:center;gap:6px;padding:9px 18px;border:1.5px solid #1a1a1a;background:#fff;border-radius:8px;cursor:pointer;font-size:.85rem;font-weight:600;}
.new-outlet-btn:hover{background:#f5f0eb;}
.outlets-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.outlet-card{background:#fff;border-radius:12px;padding:24px;border:1.5px solid #eee;cursor:default;}
.outlet-card h3{font-size:1rem;font-weight:800;margin-bottom:6px;}
.outlet-card .addr{font-size:.83rem;color:#888;margin-bottom:14px;}
.open-dash{color:#e84c1e;font-size:.85rem;font-weight:700;cursor:pointer;text-decoration:none;display:inline-flex;align-items:center;gap:4px;}
.open-dash:hover{text-decoration:underline;}
.dash-wrap{min-height:100vh;background:#f5f0eb;}
.dash-topbar{background:#fff;border-bottom:1px solid #eee;padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;}
.dash-topbar-left{display:flex;align-items:center;gap:14px;}
.back-btn{background:none;border:none;cursor:pointer;font-size:1.2rem;color:#444;padding:4px 8px;}
.shop-icon{width:36px;height:36px;background:#fde8e0;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;}
.shop-name{font-size:1rem;font-weight:800;}
.shop-sub{font-size:.75rem;color:#888;margin-top:1px;}
.dash-topbar-right{display:flex;align-items:center;gap:10px;}
.top-btn{display:flex;align-items:center;gap:6px;padding:8px 16px;border:1.5px solid #ddd;background:#fff;border-radius:8px;cursor:pointer;font-size:.82rem;font-weight:600;color:#1a1a1a;}
.top-btn:hover{border-color:#aaa;}
.ticket-btn{background:#e84c1e;color:#fff;border-color:#e84c1e;display:flex;align-items:center;gap:6px;}
.ticket-btn:hover{background:#c73d17;}
.ticket-btn .arr{font-size:.7rem;}
.dash-content{padding:24px;max-width:1100px;margin:0 auto;}
.jobs-card{background:#fff;border-radius:12px;border:1.5px solid #eee;overflow:hidden;}
.jobs-hd{display:flex;justify-content:space-between;align-items:center;padding:20px 24px;border-bottom:1px solid #f0f0f0;}
.jobs-hd h2{font-size:1rem;font-weight:800;}
.type-tabs{display:flex;gap:4px;}
.type-tab{padding:7px 16px;border:1.5px solid #ddd;background:#fff;border-radius:20px;cursor:pointer;font-size:.82rem;font-weight:600;color:#555;transition:all .15s;}
.type-tab:hover{border-color:#e84c1e;color:#e84c1e;}
.type-tab.active{background:#f5f0eb;border-color:#1a1a1a;color:#1a1a1a;}
table{width:100%;border-collapse:collapse;}
th{padding:12px 20px;text-align:left;font-size:.72rem;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:.5px;border-bottom:1.5px solid #f0f0f0;}
td{padding:16px 20px;border-bottom:1px solid #f7f7f7;font-size:.88rem;vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tr:hover td{background:#fafafa;}
tr.selected td{background:#eff6ff;border-left:3px solid #3b82f6;}
.order-id{color:#e84c1e;font-weight:700;font-size:.85rem;}
.cust-name{font-weight:700;font-size:.88rem;}
.cust-phone{font-size:.78rem;color:#888;margin-top:2px;}
.type-badge{display:inline-block;padding:4px 12px;border:1.5px solid #ddd;border-radius:20px;font-size:.78rem;font-weight:600;}
.doc-name{font-size:.85rem;color:#555;}
.doc-copies{font-size:.78rem;color:#aaa;margin-top:2px;}
.status-badge{display:inline-block;padding:5px 14px;border-radius:20px;font-size:.78rem;font-weight:600;}
.s-pending{background:#fef9c3;color:#a16207;border:1px solid #fde68a;}
.s-delivered{background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;}
.s-confirmed{background:#dbeafe;color:#1e40af;border:1px solid #bfdbfe;}
.s-completed{background:#d1fae5;color:#065f46;border:1px solid #a7f3d0;}
.s-cancelled{background:#fee2e2;color:#991b1b;border:1px solid #fecaca;}
.date-txt{font-size:.82rem;color:#888;}
.empty{text-align:center;padding:48px;color:#aaa;font-size:.9rem;}
.loading{text-align:center;padding:36px;color:#e84c1e;}
.hidden{display:none!important;}
.add-outlet-form{background:#f5f0eb;min-height:100vh;padding:32px 24px;}
.form-card{background:#fff;border-radius:12px;max-width:560px;margin:0 auto;overflow:hidden;border:1.5px solid #eee;}
.form-card-hd{padding:28px;border-bottom:1px solid #f0f0f0;display:flex;align-items:center;gap:16px;}
.form-card-hd .ic{width:48px;height:48px;background:#fde8e0;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;}
.form-card-hd h2{font-size:1.2rem;font-weight:800;}
.form-card-hd p{font-size:.82rem;color:#888;margin-top:2px;}
.form-body{padding:28px;}
.fg{margin-bottom:18px;}
.fg label{display:block;font-size:.85rem;font-weight:600;margin-bottom:7px;}
.fg input{width:100%;padding:11px 14px;border:1.5px solid #e0e0e0;border-radius:8px;font-size:.92rem;}
.fg input:focus{outline:none;border-color:#e84c1e;}
.form-row2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.form-footer{padding:20px 28px;border-top:1px solid #f0f0f0;display:flex;justify-content:flex-end;gap:10px;}
.cancel-btn{padding:11px 22px;border:1.5px solid #ddd;background:#fff;border-radius:8px;cursor:pointer;font-size:.88rem;font-weight:600;}
.create-btn{padding:11px 22px;background:#e84c1e;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:.88rem;font-weight:700;}
@media(max-width:640px){.outlets-grid{grid-template-columns:1fr;}.type-tabs{flex-wrap:wrap;}.dash-topbar-right{gap:6px;}.top-btn span{display:none;}}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="loginWrap">
  <div class="login-wrap">
    <div class="login-box">
      <h2>PrintLab Outlet</h2>
      <p>Sign in to manage your shop</p>
      <div class="lf">
        <label>Email</label><input type="email" id="lEm" placeholder="shop@printlab.in">
        <label>Password</label><input type="password" id="lPw" placeholder="Password">
        <button class="login-btn" onclick="doLogin()">Sign In</button>
        <div class="lerr" id="lErr"></div>
      </div>
    </div>
  </div>
</div>

<!-- SELECT OUTLET -->
<div id="selectWrap" class="hidden">
  <div class="select-wrap">
    <div class="select-center">
      <div class="printer-icon">🖨️</div>
      <h1>Print Lab</h1>
      <p>Select your shop to manage operations.</p>
      <div class="outlets-hd">
        <h2>Your Outlets</h2>
        <button class="new-outlet-btn" onclick="showAddOutlet()">+ New Outlet</button>
      </div>
      <div class="outlets-grid" id="outletsGrid">
        <div class="loading">Loading outlets…</div>
      </div>
    </div>
  </div>
</div>

<!-- ADD OUTLET FORM -->
<div id="addOutletWrap" class="hidden">
  <div class="add-outlet-form">
    <div class="form-card">
      <div class="form-card-hd">
        <div class="ic">🏪</div>
        <div><h2>New Print Shop</h2><p>Set up a new location to start managing orders.</p></div>
      </div>
      <div class="form-body">
        <div class="fg"><label>Shop Name</label><input id="sh-name" placeholder="e.g. Downtown Print Hub"></div>
        <div class="form-row2">
          <div class="fg"><label>URL Slug</label><input id="sh-slug" placeholder="e.g. downtown-hub"></div>
          <div class="fg"><label>Phone Number</label><input id="sh-phone" placeholder="e.g. 9876543210"></div>
        </div>
        <div class="fg"><label>Address</label><input id="sh-addr" placeholder="e.g. 123 Main St, Bangalore"></div>
      </div>
      <div class="form-footer">
        <button class="cancel-btn" onclick="showSelectOutlet()">Cancel</button>
        <button class="create-btn" onclick="createOutlet()">Create Outlet</button>
      </div>
    </div>
  </div>
</div>

<!-- SHOP DASHBOARD -->
<div id="dashWrap" class="hidden">
  <div class="dash-wrap">
    <div class="dash-topbar">
      <div class="dash-topbar-left">
        <button class="back-btn" onclick="showSelectOutlet()">←</button>
        <div class="shop-icon">🖨️</div>
        <div><div class="shop-name" id="dashShopName">Shop Name</div><div class="shop-sub">Dashboard</div></div>
      </div>
      <div class="dash-topbar-right">
        <button class="top-btn" onclick="showDeliveryTeam()"><span>👥</span><span>Delivery Team</span></button>
        <button class="top-btn" onclick="showPerformance()"><span>📊</span><span>Performance Status</span></button>
        <button class="top-btn ticket-btn" onclick="raiseTicket()"><span>🎫</span><span>Ticket Raise</span><span class="arr">▼</span></button>
      </div>
    </div>
    <div class="dash-content">
      <div class="jobs-card">
        <div class="jobs-hd">
          <h2>Active Jobs</h2>
          <div class="type-tabs">
            <button class="type-tab active" onclick="filterJobs('all',this)">B/W</button>
            <button class="type-tab" onclick="filterJobs('colour',this)">Colour</button>
            <button class="type-tab" onclick="filterJobs('photo',this)">Photo</button>
            <button class="type-tab" onclick="filterJobs('tshirt',this)">T-Shirt</button>
            <button class="type-tab" onclick="filterJobs('project',this)">Project</button>
          </div>
        </div>
        <div id="jobsTable"><div class="loading">Loading…</div></div>
      </div>
    </div>
  </div>
</div>

<script>
const API = window.location.origin;
let tok = localStorage.getItem('pl_shop');
let allJobs = [];
let curShop = null;
if(tok) showSelectOutlet();

async function doLogin(){
  try{
    const r=await fetch(API+'/api/v1/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:document.getElementById('lEm').value,password:document.getElementById('lPw').value})});
    const d=await r.json();
    if(d.access_token){tok=d.access_token;localStorage.setItem('pl_shop',tok);showSelectOutlet();}
    else document.getElementById('lErr').textContent='Invalid credentials';
  }catch(e){document.getElementById('lErr').textContent='Cannot connect to server';}
}
function hide(id){document.getElementById(id).classList.add('hidden');}
function show(id){document.getElementById(id).classList.remove('hidden');}
function showSelectOutlet(){hide('loginWrap');hide('dashWrap');hide('addOutletWrap');show('selectWrap');loadOutlets();}
function showAddOutlet(){hide('selectWrap');show('addOutletWrap');}
function showDash(shop){curShop=shop;hide('selectWrap');show('dashWrap');document.getElementById('dashShopName').textContent=shop.name;loadJobs();}

async function api(u,m,b){
  const o={method:m||'GET',headers:{Authorization:'Bearer '+tok}};
  if(b){o.headers['Content-Type']='application/json';o.body=JSON.stringify(b);}
  const r=await fetch(API+u,o);return r.json();
}

async function loadOutlets(){
  try{
    const d=await api('/api/v1/shops');
    const shops=Array.isArray(d)?d:(d.data||[]);
    if(!shops.length){document.getElementById('outletsGrid').innerHTML='<div class="outlet-card"><p style="color:#888">No outlets yet. Click + New Outlet to add one.</p></div>';return;}
    document.getElementById('outletsGrid').innerHTML=shops.map(s=>`
      <div class="outlet-card">
        <h3>${s.name||'Unnamed Shop'}</h3>
        <div class="addr">${s.address||'No address set'}</div>
        <a class="open-dash" onclick="showDash(${JSON.stringify(s).replace(/"/g,'&quot;')})">Open Dashboard →</a>
      </div>`).join('');
  }catch(e){document.getElementById('outletsGrid').innerHTML='<div class="empty">Error loading outlets</div>';}
}

async function createOutlet(){
  const name=document.getElementById('sh-name').value;
  const phone=document.getElementById('sh-phone').value;
  const address=document.getElementById('sh-addr').value;
  if(!name)return alert('Shop name is required');
  try{
    await api('/api/v1/shops','POST',{name,phone,address,is_active:true});
    showSelectOutlet();
  }catch(e){alert('Error creating outlet');}
}

async function loadJobs(){
  try{
    const d=await api('/api/v1/orders');
    allJobs=Array.isArray(d)?d:(d.data||[]);
    renderJobs(allJobs);
  }catch(e){document.getElementById('jobsTable').innerHTML='<div class="empty">Error loading orders</div>';}
}

function filterJobs(type,el){
  document.querySelectorAll('.type-tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  if(type==='all') renderJobs(allJobs);
  else{
    const map={colour:'colour',photo:'photo',tshirt:'tshirt',project:'project'};
    renderJobs(allJobs.filter(o=>JSON.stringify(o).toLowerCase().includes(map[type]||type)));
  }
}

function stClass(s){
  if(!s)return 's-pending';
  const m={pending:'s-pending',confirmed:'s-confirmed',completed:'s-completed',delivered:'s-delivered',cancelled:'s-cancelled'};
  return m[s]||'s-pending';
}
function guessType(o){
  const s=JSON.stringify(o).toLowerCase();
  if(s.includes('colour')||s.includes('color'))return'Colour';
  if(s.includes('photo'))return'Photo';
  if(s.includes('tshirt')||s.includes('t-shirt'))return'T-Shirt';
  if(s.includes('project'))return'Project';
  return'Bw';
}

function renderJobs(jobs){
  if(!jobs.length){document.getElementById('jobsTable').innerHTML='<div class="empty">No active jobs</div>';return;}
  document.getElementById('jobsTable').innerHTML='<table><tr><th>Order ID</th><th>Customer</th><th>Type</th><th>Document</th><th>Status</th><th>Date</th></tr>'+jobs.map(o=>`
    <tr onclick="this.classList.toggle('selected')">
      <td><span class="order-id">${o.order_number||o.id.slice(0,10)}</span></td>
      <td><div class="cust-name">${o.user_name||'Customer'}</div><div class="cust-phone">${o.user_phone||''}</div></td>
      <td><span class="type-badge">${guessType(o)}</span></td>
      <td><div class="doc-name">${o.file_name||'document.pdf'}</div><div class="doc-copies">x${o.copies||1}</div></td>
      <td><span class="status-badge ${stClass(o.status)}">${o.status||'Pending'}</span></td>
      <td><span class="date-txt">${new Date(o.created_at).toLocaleDateString('en-IN',{month:'short',day:'numeric'})}, ${new Date(o.created_at).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'})}</span></td>
    </tr>`).join('')+'</table>';
}

function showDeliveryTeam(){alert('Delivery Team panel — coming soon');}
function showPerformance(){alert('Performance Status — coming soon');}
function raiseTicket(){alert('Raise a ticket — connect to POST /api/v1/tickets');}
setInterval(()=>{if(curShop&&!document.getElementById('dashWrap').classList.contains('hidden'))loadJobs();},15000);
</script>
</body>
</html>